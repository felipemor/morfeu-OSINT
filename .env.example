# =============================================================
# AI AUTONOMOUS PENTEST PLATFORM — Environment Configuration
# =============================================================
# Copy this file to .env and fill in the values before running.
# NEVER commit .env to version control.

# ─── Application ──────────────────────────────────────────────
APP_NAME=AI Autonomous Pentest Platform
APP_VERSION=1.0.0
ENVIRONMENT=development

# ─── Security (CHANGE THESE!) ─────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Admin User (bootstrapped on first start) ─────────────────
ADMIN_EMAIL=admin@pentest.local
ADMIN_PASSWORD=changeme123!
ADMIN_FULL_NAME=Platform Admin

# ─── Database ─────────────────────────────────────────────────
POSTGRES_USER=pentest
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=pentest
DATABASE_URL=postgresql+asyncpg://pentest:changeme_in_production@postgres:5432/pentest
DATABASE_URL_SYNC=postgresql://pentest:changeme_in_production@postgres:5432/pentest

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── File Storage ─────────────────────────────────────────────
SCREENSHOTS_DIR=/data/screenshots
REPORTS_DIR=/data/reports

# ─── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ─── LLM Provider (optional) ──────────────────────────────────
# Options: openai | anthropic | gemini | ollama | disabled
LLM_PROVIDER=disabled
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# ─── Rate Limiting ────────────────────────────────────────────
GLOBAL_RATE_LIMIT_PER_MINUTE=60

# ─── Monitoring ───────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=changeme_grafana
